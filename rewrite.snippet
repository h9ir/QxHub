# >>>>>>>>>>>>>>> ✅ A ✅ <<<<<<<<<<<<<<
# > Apple
# hostname = mesu.apple.com, gdmf.apple.com
# iOS 正式版更新检测
^https?:\/\/mesu\.apple\.com\/assets\/com_apple_MobileAsset_SoftwareUpdate\/com_apple_MobileAsset_SoftwareUpdate\.xml$ url reject
