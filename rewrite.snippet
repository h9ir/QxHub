^https?:\/\/mesu\.apple\.com\/assets\/com_apple_MobileAsset_SoftwareUpdate\/com_apple_MobileAsset_SoftwareUpdate_Beta\.xml$ url reject
# 更新策略接口
^https?:\/\/gdmf\.apple\.com\/v2\/(pmv|assets) url reject


