# >>>>>>>>>>>>>>> ✅ J ✅ <<<<<<<<<<<<<<
# > Jable
# hostname = 91jable.top, 91jable.sbs, jable.cfd, jable1.com, jable888.com, jable888.net, jable1.net, jable1.art, jable1.nl, *.jable.tv, en.jable.tv, jable.tv
^https?:\/\/(jable|(en|\w{2,3})\.jable)\.tv\/(?!(.*(\?mode|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf))))).* url script-response-body https://limbopro.com/Adguard/Adblock4limbo.js
# Jable_MultiDomain(优先维护jable.tv，其他为盗版镜像站或有添料)  
^https?:\/\/(?:[a-zA-Z0-9-]+\.)*(?:91jable\.(?:top|sbs)|jable\.(?:cfd|tv)|jable1\.(?:com|net|art|nl)|jable888\.(?:com|net))\/(?!(?:.*\?(?:mode|login|cdn-cgi|verify|auth|captch)|.*\.(?:js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf)$)).* url script-response-body https://limbopro.com/Adguard/Adblock4limbo.js


